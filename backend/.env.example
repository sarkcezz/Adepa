APP_NAME="Adepa Pork Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.adepaporkhub.com
APP_TIMEZONE=Africa/Accra

LOG_CHANNEL=stack
LOG_LEVEL=warning

# MySQL (Hostinger hPanel → Databases)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adepaporkhub_db
DB_USERNAME=adepaporkhub_user
DB_PASSWORD=

BROADCAST_DRIVER=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_DRIVER=file
SESSION_DRIVER=database
SESSION_LIFETIME=10080

# Sanctum (SPA token auth)
SANCTUM_STATEFUL_DOMAINS=adepaporkhub.com,www.adepaporkhub.com
SESSION_DOMAIN=.adepaporkhub.com

# Paystack
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# Hubtel SMS
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=AdepaPork
HUBTEL_BASE_URL=https://sms.hubtel.com/v1/messages

# SendGrid
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="orders@adepaporkhub.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=adepa

# Admin seed
ADMIN_NAME="Adepa Admin"
ADMIN_EMAIL=admin@adepaporkhub.com
ADMIN_PHONE=0200000001
ADMIN_PASSWORD=ChangeMe@2025!

# Frontend
FRONTEND_URL=https://adepaporkhub.com
