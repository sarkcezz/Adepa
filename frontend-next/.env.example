# Neon Postgres — injected automatically by the Vercel ↔ Neon integration.
# For local dev, copy the connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Bootstrap admin for `npm run db:seed` (clean launch — admin only).
# All optional; safe defaults are used if unset. First login forces a change.
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PHONE=""
SEED_ADMIN_PASSWORD=""
# Only for the populated demo dataset (`npm run db:seed:demo`).
SEED_STAFF_PASSWORD=""

# Frontend → API base. Defaults to same-origin /api — leave unset.
NEXT_PUBLIC_API_BASE_URL="/api"
