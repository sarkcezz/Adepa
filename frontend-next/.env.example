# Neon Postgres — injected automatically by the Vercel ↔ Neon integration.
# For local dev, copy the connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Bootstrap admin for `npm run db:seed` (clean launch — admin only).
# All optional; safe defaults are used if unset. First login forces a change.
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PHONE=""
SEED_ADMIN_PASSWORD=""
# Only for the populated demo dataset (`npm run db:seed:demo`).
SEED_STAFF_PASSWORD=""

# Frontend → API base. Defaults to same-origin /api — leave unset.
NEXT_PUBLIC_API_BASE_URL="/api"

# Absolute site origin — used to build links in emails (password reset) and
# the sitemap/robots. On Vercel this falls back to VERCEL_URL automatically
# (injected by the platform, not set here); set this to override, or for
# local dev if you need absolute links to point somewhere other than
# localhost:3000.
NEXT_PUBLIC_SITE_URL=""

# Paystack — payments. Public key is used client-side for the checkout
# popup; secret key verifies transactions server-side and validates webhook
# signatures. Until PAYSTACK_SECRET_KEY is set, payment references are
# trusted without verification (a console warning is logged each time).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# Vercel Blob — product/event/announcement image uploads (admin panel).
# Create a Blob store in the Vercel dashboard (Storage tab); the token is
# injected automatically for deployments. Without it, uploads return 501.
BLOB_READ_WRITE_TOKEN=""

# Vercel Cron — guards /api/cron/* so only Vercel's scheduler can trigger
# them (sent as `Authorization: Bearer $CRON_SECRET`). Optional locally —
# cron routes run unauthenticated when unset.
CRON_SECRET=""

# Email — order confirmations, status updates, password resets, low-stock
# and daily-summary alerts. Set either RESEND_API_KEY or SMTP_URL; without
# one, emails are logged to the console instead of sent.
RESEND_API_KEY=""
SMTP_URL=""
# Where low-stock/daily-summary cron alerts and cancellation notices are
# sent. Defaults to admin@adepaporkhub.shop if unset.
ADMIN_ALERT_EMAIL=""

# SMS — order/employee notifications via Hubtel (Ghana). HUBTEL_CLIENT_ID is
# checked to decide whether to send; HUBTEL_CLIENT_SECRET will be needed once
# the actual Hubtel API call is wired in (currently logs to the console).
HUBTEL_CLIENT_ID=""
HUBTEL_CLIENT_SECRET=""
