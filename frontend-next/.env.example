# Neon Postgres — injected automatically by the Vercel ↔ Neon integration.
# For local dev, copy the connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Seed passwords (optional — safe defaults are used if unset).
SEED_ADMIN_PASSWORD=""
SEED_STAFF_PASSWORD=""

# Frontend → API base. Defaults to same-origin /api (the ported backend).
# Set to an absolute URL to use the legacy Laravel API during transition.
NEXT_PUBLIC_API_BASE_URL="/api"

# Phase 2 data migration only — legacy MySQL connection (Hostinger).
# Used by `npm run db:import`. Remove/leave unset outside migration.
SOURCE_MYSQL_URL="mysql://user:pass@host:3306/dbname"
